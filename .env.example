# ==========================================
# Telegram Video Forwarder & Re-Uploader Bot
# ==========================================

# ১. my.telegram.org থেকে API_ID এবং API_HASH নিন (ফ্রি)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ২. @BotFather থেকে নেওয়া Bot Token
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ৩. আপনার নিজের টেলিগ্রাম ইউজার আইডি (Security: যাতে অন্য কেউ অপব্যবহার না করতে পারে)
# আইডি না জানলে বট চালু করে /id দিন অথবা @userinfobot এ গিয়ে স্টার্ট দিন
OWNER_ID=0

# ৪. যে গ্রুপ বা চ্যানেলে ভিডিও আপলোড হবে তার ID
# সুপারগ্রুপ বা চ্যানেলের ID সাধারণত -100 দিয়ে শুরু হয় (যেমন: -1001234567890) অথবা পাবলিক গ্রুপ হলে @my_group_name
TARGET_CHAT_ID=

# ৫. ক্যাপশন মোড:
# "original" = ভিডিওর আসল ক্যাপশন রাখা হবে
# "none"     = কোনো ক্যাপশন থাকবে না (ক্লিন ভিডিও)
# "custom"   = নিচের CUSTOM_CAPTION ব্যবহার করা হবে
# "append"   = আসল ক্যাপশনের শেষে WATERMARK_TEXT যোগ হবে
CAPTION_MODE=original

# কাস্টম ক্যাপশন (যদি CAPTION_MODE=custom হয়)
CUSTOM_CAPTION=Uploaded by My Bot 🚀

# ওয়াটারমার্ক / ফুটার টেক্সট (যদি CAPTION_MODE=append হয়)
WATERMARK_TEXT=Join our channel: @mychannel
